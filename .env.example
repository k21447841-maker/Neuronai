SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
DATABASE_URL=postgresql+psycopg://postgres:your-password@db.your-project.supabase.co:5432/postgres
APP_ENV=production
BACKEND_CORS_ORIGINS=http://localhost:5173,https://neuroflow-ai.vercel.app
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-url-safe-base64-fernet-key
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback
MEDIA_WORK_DIR=/tmp/neuroflow_work
BLENDER_BINARY_PATH=/usr/bin/blender
FFMPEG_BINARY_PATH=/usr/bin/ffmpeg
WHISPER_MODEL_SIZE=base
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://localhost:8000
